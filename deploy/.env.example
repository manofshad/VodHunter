# Copy this file to the repository root as .env on the VPS. Keep database and
# observability credentials in Coolify's secret store rather than in Git.

# The database is a separate Coolify PostgreSQL/PGVector resource on the same
# destination. Store the generated Internal URL in Coolify's secret store.
DATABASE_URL=postgresql://vodhunter:replace-with-a-database-password@postgres-<coolify-resource-id>:5432/vodhunter

# Temporary rollout value. Raise to 60 after verifying retention behavior.
VOD_RETENTION_DAYS=30

# The worker uses Twitch Helix polling.
TWITCH_STREAMER=jasontheween
HYBRID_INGEST_DAYS=30
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Internal dashboard integration.
INTERNAL_API_KEY=

# Grafana Cloud Alloy export. Store the token as a VPS/Coolify secret.
GRAFANA_CLOUD_PROMETHEUS_URL=https://prometheus-prod-<region>.grafana.net/api/prom/push
GRAFANA_CLOUD_PROMETHEUS_USER=
GRAFANA_CLOUD_LOKI_URL=https://logs-prod-<region>.grafana.net/loki/api/v1/push
GRAFANA_CLOUD_LOKI_USER=
GRAFANA_CLOUD_API_TOKEN=
VODHUNTER_ENVIRONMENT=production
