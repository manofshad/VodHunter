# Copy this file to the repository root as .env on the VPS.
# Generate one safe alphanumeric password and use it in both places below.

POSTGRES_DB=vodhunter
POSTGRES_USER=vodhunter
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://vodhunter:replace-with-a-long-random-password@db:5432/vodhunter

# The worker uses Twitch Helix polling. EventSub is intentionally disabled for now.
TWITCH_STREAMER=jasontheween
HYBRID_INGEST_DAYS=2
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
