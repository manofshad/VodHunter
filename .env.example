# Runtime deployment values.
DATABASE_URL=postgresql://vodhunter:change-me@localhost:5432/vodhunter
VOD_RETENTION_DAYS=30

# NMFP artifact locations. The model/preprocessing identity and vector dimension
# are pinned in pipeline/nmfp_inference.py; these paths only locate the artifacts.
NMFP_REPOSITORY_PATH=/opt/neural-music-fp
NMFP_MODEL_CONFIG_PATH=/opt/neural-music-fp/pretrained_models/nmfp-triplet/config.yaml

# Query fingerprinting runs locally in the API process. The model is preloaded
# at startup and a single-consumer queue serializes only NMFP extraction.

# pgvector approximate-search tuning. Iterative scans require pgvector 0.8.0+
# and keep creator/date-filtered HNSW searches from returning too few rows.
HNSW_EF_SEARCH=100
HNSW_ITERATIVE_SCAN=strict_order
HNSW_MAX_SCAN_TUPLES=20000
HNSW_SCAN_MEM_MULTIPLIER=1

# Twitch ingestion.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Internal dashboard integration.
INTERNAL_API_KEY=

# Grafana Cloud Alloy export. Use separate metrics/logs user IDs from the
# Grafana Cloud connection details and keep the token in the VPS secret store.
GRAFANA_CLOUD_PROMETHEUS_URL=https://prometheus-prod-<region>.grafana.net/api/prom/push
GRAFANA_CLOUD_PROMETHEUS_USER=
GRAFANA_CLOUD_LOKI_URL=https://logs-prod-<region>.grafana.net/loki/api/v1/push
GRAFANA_CLOUD_LOKI_USER=
GRAFANA_CLOUD_API_TOKEN=
VODHUNTER_ENVIRONMENT=production
