# Database and vector index. VECTOR_DIM is fixed by the pinned NMFP checkpoint.
DATABASE_URL=postgresql://vodhunter:change-me@localhost:5432/vodhunter
VECTOR_DIM=128
HNSW_EF_SEARCH=40

# Exact production fingerprint identity. Ingest and search must remain identical.
NMFP_MODEL_VERSION=nmfp-triplet@15c6f3bcdf6a6da1daddfe47a1ffa5a0d22deadc+zenodo-15719945+ckpt-100
NMFP_PREPROCESSING_VERSION=nmfp-8khz-mono-1s-hop0.5-mel-v1
NMFP_REPOSITORY_PATH=/opt/neural-music-fp
NMFP_MODEL_CONFIG_PATH=/opt/neural-music-fp/pretrained_models/nmfp-triplet/config.yaml
NMFP_SAMPLE_RATE=8000
NMFP_WINDOW_SECONDS=1.0
NMFP_HOP_SECONDS=0.5

# Candidate retrieval and cut-aware alignment defaults. Tune only with evaluation data.
SEARCH_TOP_K=10
CUT_OFFSET_BIN_SECONDS=0.5
CUT_OFFSET_TOLERANCE_SECONDS=1.0
CUT_MAX_UNMATCHED_GAP_SECONDS=2.0
CUT_MIN_SUPPORT=6
CUT_MIN_SEGMENT_DURATION_SECONDS=4.0
CUT_MIN_DENSITY=0.4
CUT_MERGE_QUERY_GAP_SECONDS=1.0
CUT_MERGE_OFFSET_TOLERANCE_SECONDS=4.0
CUT_MAX_SEGMENTS=12

# Modal query-fingerprint worker. Model identity comes from NMFP_MODEL_VERSION.
MODAL_SEARCH_APP_NAME=vodhunter-search-embedder
MODAL_SEARCH_FUNCTION_NAME=embed_search_wav
MODAL_SEARCH_TIMEOUT_SECONDS=120
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Twitch ingestion.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_EVENTSUB_SECRET=
TWITCH_EVENTSUB_CALLBACK_URL=

# API boundaries.
PUBLIC_API_ORIGIN=http://localhost:8001
ADMIN_API_ORIGIN=http://localhost:8001
INTERNAL_API_KEY=
