map $request_method $public_search_create_key {
    default "";
    POST $binary_remote_addr;
}
limit_req_zone $public_search_create_key zone=public_search:10m rate=6r/m;

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    limit_req_status 429;
    error_page 429 = @search_rate_limited;
    error_page 413 = @search_upload_too_large;

    location = /api/search/clip {
        client_max_body_size 101m;
        proxy_request_buffering off;
        proxy_http_version 1.1;
        limit_req zone=public_search burst=2 nodelay;
        proxy_pass ${PUBLIC_API_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/ {
        proxy_pass ${PUBLIC_API_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ^~ /internal/ {
        return 404;
    }

    location @search_rate_limited {
        default_type application/json;
        return 429 '{"detail":{"code":"RATE_LIMITED","message":"Too many search requests. Please wait a moment and try again."}}';
    }

    location @search_upload_too_large {
        default_type application/json;
        add_header Cache-Control no-store always;
        return 413 '{"detail":{"code":"UPLOAD_TOO_LARGE","message":"Search request must be 101 MiB or smaller."}}';
    }

    location ^~ /shortcuts/ {
        types { application/x-apple-shortcut shortcut; }
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
