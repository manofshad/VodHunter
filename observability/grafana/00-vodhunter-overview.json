{
  "__inputs": [
    {
      "name": "DS_LOGS",
      "label": "Logs datasource",
      "type": "datasource",
      "pluginId": "loki",
      "pluginName": "Loki"
    },
    {
      "name": "DS_POSTGRES",
      "label": "Reporting datasource",
      "type": "datasource",
      "pluginId": "grafana-postgresql-datasource",
      "pluginName": "PostgreSQL"
    }
  ],
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [
    {
      "asDropdown": true,
      "icon": "external link",
      "includeVars": true,
      "keepTime": true,
      "tags": [
        "vodhunter"
      ],
      "targetBlank": false,
      "title": "VodHunter dashboards",
      "type": "dashboards"
    },
    {
      "title": "Browser experience",
      "type": "link",
      "url": "/a/grafana-kowalski-app",
      "targetBlank": false
    }
  ],
  "panels": [
    {
      "type": "stat",
      "title": "Accepted searches",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_POSTGRES}"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COUNT(*)::double precision AS value FROM grafana_search_quality WHERE $__timeFilter(created_at)",
          "refId": "A",
          "sql": {
            "columns": [],
            "groupBy": []
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No observations",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "description": "Durable accepted jobs in the selected range. Browser validation and edge rate limits are excluded.",
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "id": 1
    },
    {
      "type": "stat",
      "title": "Technical completion",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_POSTGRES}"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 4,
        "y": 0
      },
      "targets": [
        {
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COUNT(*) FILTER (WHERE job_status = 'completed')::double precision / NULLIF(COUNT(*) FILTER (WHERE job_status IN ('completed', 'failed')), 0) AS value FROM grafana_search_quality WHERE $__timeFilter(created_at)",
          "refId": "A",
          "sql": {
            "columns": [],
            "groupBy": []
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "No observations",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "description": "Completed / terminal jobs. No-match is a technical completion; pending jobs appear separately.",
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "id": 2
    },
    {
      "type": "stat",
      "title": "Accepted-to-finish p95",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_POSTGRES}"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 8,
        "y": 0
      },
      "targets": [
        {
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT percentile_cont(0.95) WITHIN GROUP (ORDER BY EXTRACT(EPOCH FROM finished_at-created_at)) AS value FROM grafana_search_quality WHERE $__timeFilter(created_at) AND finished_at IS NOT NULL",
          "refId": "A",
          "sql": {
            "columns": [],
            "groupBy": []
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No observations",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "description": "Durable server wall-clock elapsed time, including queue wait. This does not measure browser result rendering.",
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "id": 3
    },
    {
      "type": "stat",
      "title": "Failed searches",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_POSTGRES}"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COUNT(*)::double precision AS value FROM grafana_search_quality WHERE $__timeFilter(created_at) AND job_status = 'failed'",
          "refId": "A",
          "sql": {
            "columns": [],
            "groupBy": []
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No observations",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "id": 4
    },
    {
      "type": "stat",
      "title": "Match rate",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_POSTGRES}"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 16,
        "y": 0
      },
      "targets": [
        {
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COUNT(*) FILTER (WHERE outcome = 'match')::double precision / NULLIF(COUNT(*) FILTER (WHERE outcome IN ('match', 'no_match')), 0) AS value FROM grafana_search_quality WHERE $__timeFilter(created_at)",
          "refId": "A",
          "sql": {
            "columns": [],
            "groupBy": []
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "No observations",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "description": "Matches / completed searches. Confidence and match rate do not prove correctness.",
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "id": 5
    },
    {
      "type": "stat",
      "title": "Pending searches now",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_POSTGRES}"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 20,
        "y": 0
      },
      "targets": [
        {
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COUNT(*)::double precision AS value FROM grafana_search_quality WHERE job_status IN ('queued','running')",
          "refId": "A",
          "sql": {
            "columns": [],
            "groupBy": []
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No observations",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "description": "Current persisted pending jobs, independent of the selected historical range.",
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "id": 6
    },
    {
      "type": "timeseries",
      "title": "Accepted search outcomes",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_POSTGRES}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(created_at, $__interval), outcome AS metric, COUNT(*)::double precision AS value FROM grafana_search_quality WHERE $__timeFilter(created_at) GROUP BY 1,outcome ORDER BY 1",
          "refId": "A",
          "sql": {
            "columns": [],
            "groupBy": []
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No observations",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 12,
            "lineInterpolation": "linear",
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 7
    },
    {
      "type": "table",
      "title": "Current content health",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_POSTGRES}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "targets": [
        {
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT streamer AS \"Streamer\", searchable_vods AS \"Searchable VODs\", active_vods AS \"Active\", stalled_vods AS \"Stalled\", ROUND(EXTRACT(EPOCH FROM NOW()-newest_vod_at)::numeric / 86400, 1) AS \"Newest age (d)\" FROM grafana_streamer_summary ORDER BY stalled_vods DESC, streamer",
          "refId": "A",
          "sql": {
            "columns": [],
            "groupBy": []
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "\u2014",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^(.*[ _]ID|search_id|Twitch VOD)$"
            },
            "properties": [
              {
                "id": "unit",
                "value": "none"
              }
            ]
          }
        ]
      },
      "description": "Current state, not historical ingest throughput. An offline creator naturally has older content.",
      "options": {
        "cellHeight": "sm",
        "showHeader": true
      },
      "id": 8
    },
    {
      "type": "logs",
      "title": "Recent operational errors",
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOGS}"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 13
      },
      "targets": [
        {
          "expr": "{service_name=~\"vodhunter-api|vodhunter-worker|vodhunter-retention\", environment=\"production\"} |~ \"(?i)error|failed|exception\"",
          "refId": "A",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No observations",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "description": "No matching lines means no observed errors in this window, provided logs are arriving. Open Monitoring Health to check collection.",
      "options": {
        "enableLogDetails": true,
        "prettifyLogMessage": true,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLines": true
      },
      "id": 9
    }
  ],
  "refresh": "1m",
  "schemaVersion": 39,
  "tags": [
    "vodhunter",
    "overview"
  ],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "title": "00 - User Experience Overview",
  "uid": "vodhunter-overview",
  "version": 1
}
