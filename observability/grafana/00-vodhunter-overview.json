{
  "__inputs": [
    {
      "name": "DS_LOGS",
      "label": "Logs datasource",
      "type": "datasource",
      "pluginId": "loki",
      "pluginName": "Loki"
    },
    {
      "name": "DS_POSTGRES",
      "label": "PostgreSQL datasource",
      "type": "datasource",
      "pluginId": "grafana-postgresql-datasource",
      "pluginName": "PostgreSQL"
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [
    {
      "asDropdown": true,
      "icon": "external link",
      "includeVars": true,
      "keepTime": true,
      "tags": [
        "vodhunter"
      ],
      "targetBlank": false,
      "title": "VodHunter dashboards",
      "type": "dashboards"
    }
  ],
  "panels": [
    {
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_POSTGRES}"
      },
      "description": "Durable accepted jobs in the selected range. Browser validation and edge rate limits are excluded.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "fixedColor": "blue",
            "mode": "fixed"
          },
          "noValue": "No observations",
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COUNT(*)::double precision AS value FROM grafana_search_quality WHERE $__timeFilter(created_at)",
          "refId": "A",
          "sql": {
            "columns": [],
            "groupBy": []
          }
        }
      ],
      "title": "Accepted searches",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_POSTGRES}"
      },
      "description": "Completed / terminal jobs. No-match is a technical completion; pending jobs appear separately.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "fixedColor": "blue",
            "mode": "fixed"
          },
          "noValue": "No observations",
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 4,
        "y": 0
      },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COUNT(*) FILTER (WHERE job_status = 'completed')::double precision / NULLIF(COUNT(*) FILTER (WHERE job_status IN ('completed', 'failed')), 0) AS value FROM grafana_search_quality WHERE $__timeFilter(created_at)",
          "refId": "A",
          "sql": {
            "columns": [],
            "groupBy": []
          }
        }
      ],
      "title": "Technical completion",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_POSTGRES}"
      },
      "description": "Durable server wall-clock elapsed time, including queue wait. This does not measure browser result rendering.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "fixedColor": "blue",
            "mode": "fixed"
          },
          "noValue": "No observations",
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 8,
        "y": 0
      },
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT percentile_cont(0.95) WITHIN GROUP (ORDER BY EXTRACT(EPOCH FROM finished_at-created_at)) AS value FROM grafana_search_quality WHERE $__timeFilter(created_at) AND finished_at IS NOT NULL",
          "refId": "A",
          "sql": {
            "columns": [],
            "groupBy": []
          }
        }
      ],
      "title": "Accepted-to-finish p95",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_POSTGRES}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "noValue": "No observations",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green"
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 12,
        "y": 0
      },
      "id": 4,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COUNT(*)::double precision AS value FROM grafana_search_quality WHERE $__timeFilter(created_at) AND job_status = 'failed'",
          "refId": "A",
          "sql": {
            "columns": [],
            "groupBy": []
          }
        }
      ],
      "title": "Failed searches",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_POSTGRES}"
      },
      "description": "Matches / completed searches. Confidence and match rate do not prove correctness.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "fixedColor": "blue",
            "mode": "fixed"
          },
          "noValue": "No observations",
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 16,
        "y": 0
      },
      "id": 5,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COUNT(*) FILTER (WHERE outcome = 'match')::double precision / NULLIF(COUNT(*) FILTER (WHERE outcome IN ('match', 'no_match')), 0) AS value FROM grafana_search_quality WHERE $__timeFilter(created_at)",
          "refId": "A",
          "sql": {
            "columns": [],
            "groupBy": []
          }
        }
      ],
      "title": "Match rate",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_POSTGRES}"
      },
      "description": "Current persisted pending jobs, independent of the selected historical range.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "fixedColor": "blue",
            "mode": "fixed"
          },
          "noValue": "No observations",
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 20,
        "y": 0
      },
      "id": 6,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COUNT(*)::double precision AS value FROM grafana_search_quality WHERE job_status IN ('queued','running')",
          "refId": "A",
          "sql": {
            "columns": [],
            "groupBy": []
          }
        }
      ],
      "title": "Pending searches now",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_POSTGRES}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 12,
            "lineInterpolation": "linear",
            "showPoints": "never",
            "spanNulls": false
          },
          "noValue": "No observations",
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "id": 7,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(created_at, $__interval), outcome AS metric, COUNT(*)::double precision AS value FROM grafana_search_quality WHERE $__timeFilter(created_at) GROUP BY 1,outcome ORDER BY 1",
          "refId": "A",
          "sql": {
            "columns": [],
            "groupBy": []
          }
        }
      ],
      "title": "Accepted search outcomes",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_POSTGRES}"
      },
      "description": "Current state, not historical ingest throughput. An offline creator naturally has older content. The reporting view calls an indexing VOD active when its cursor was updated within 10 minutes. An older or missing update is a stale cursor. This does not prove that processing is advancing or that the worker failed.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "noValue": "No rows",
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^(.*[ _]ID|search_id|Twitch VOD)$"
            },
            "properties": [
              {
                "id": "unit",
                "value": "none"
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "id": 8,
      "options": {
        "cellHeight": "sm",
        "showHeader": true
      },
      "targets": [
        {
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT streamer AS \"Streamer\", searchable_vods AS \"Searchable VODs\", active_vods AS \"Recent cursors\", stalled_vods AS \"Stale cursors\", ROUND(EXTRACT(EPOCH FROM NOW()-newest_vod_at)::numeric / 86400, 1) AS \"Newest age (d)\" FROM grafana_streamer_summary ORDER BY stalled_vods DESC, streamer",
          "refId": "A",
          "sql": {
            "columns": [],
            "groupBy": []
          }
        }
      ],
      "title": "Current content health",
      "type": "table"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOGS}"
      },
      "description": "API error and critical levels, worker failed lines and error= diagnostics, and failed retention events. No matching lines means no observed errors in this window, provided logs are arriving. Open Monitoring Health to check collection.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "noValue": "No observations",
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 13
      },
      "id": 9,
      "options": {
        "enableLogDetails": true,
        "prettifyLogMessage": true,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLines": true
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "{service_name=\"vodhunter-api\", environment=\"production\", level=~\"error|critical\"}",
          "queryType": "range",
          "refId": "A"
        },
        {
          "editorMode": "code",
          "expr": "{service_name=\"vodhunter-worker\", environment=\"production\"} |~ \"^failed |(^| )error=\"",
          "queryType": "range",
          "refId": "B"
        },
        {
          "editorMode": "code",
          "expr": "{service_name=\"vodhunter-retention\", environment=\"production\", event=\"vod_retention_failed\"}",
          "queryType": "range",
          "refId": "C"
        }
      ],
      "title": "Recent operational errors",
      "type": "logs"
    }
  ],
  "refresh": "1m",
  "schemaVersion": 42,
  "tags": [
    "vodhunter",
    "overview"
  ],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "title": "00 - User Experience Overview",
  "weekStart": "",
  "uid": "vodhunter-overview"
}
