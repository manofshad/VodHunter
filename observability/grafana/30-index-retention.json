          "type": "grafana-postgresql-datasource",
          "uid": "${DS_POSTGRES}"
        },
        "definition": "SELECT streamer AS __text, streamer AS __value FROM grafana_streamer_summary ORDER BY streamer",
        "hide": 0,
        "includeAll": true,
        "label": "Streamer",
        "multi": false,
        "name": "streamer",
        "options": [],
        "query": "SELECT streamer AS __text, streamer AS __value FROM grafana_streamer_summary ORDER BY streamer",
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "sort": 1,
        "type": "query",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "hide": 0,
        "label": "Assumed retention days",
        "name": "retention_days",
        "query": "30",
        "skipUrlSync": true,
        "type": "constant",
        "options": [],
        "current": {
          "text": "30",
          "value": "30"
        },
        "description": "The dashboard assumes the deployment default of 30 days. This is not a measurement of the running retention configuration."
      }
    ]
  },
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "title": "30 - Index & Retention",
  "weekStart": "",
