{
  "__inputs": [
    {
      "name": "DS_METRICS",
      "label": "Metrics datasource",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    },
    {
      "name": "DS_LOGS",
      "label": "Logs datasource",
      "type": "datasource",
      "pluginId": "loki",
      "pluginName": "Loki"
    },
    {
      "name": "DS_POSTGRES",
      "label": "Reporting datasource",
      "type": "datasource",
      "pluginId": "grafana-postgresql-datasource",
      "pluginName": "PostgreSQL"
    }
  ],
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [
    {
      "asDropdown": true,
      "icon": "external link",
      "includeVars": true,
      "keepTime": true,
      "tags": [
        "vodhunter"
      ],
      "targetBlank": false,
      "title": "VodHunter dashboards",
      "type": "dashboards"
    },
    {
      "title": "Browser experience",
      "type": "link",
      "url": "/a/grafana-kowalski-app",
      "targetBlank": false
    }
  ],
  "panels": [
    {
      "type": "stat",
      "title": "API scrape up",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_METRICS}"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "min(up{job=\"prometheus.scrape.vodhunter_api\"})",
          "legendFormat": "",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No observations",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "description": "Private telemetry reachability, not an external availability probe.",
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "id": 1
    },
    {
      "type": "stat",
      "title": "Latest scrape age",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_METRICS}"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "expr": "time() - max(timestamp(up{job=\"prometheus.scrape.vodhunter_api\"}))",
          "legendFormat": "",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No observations",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "description": "A fresh zero up sample indicates scrape failure; no sample indicates unknown collection state.",
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "id": 2
    },
    {
      "type": "stat",
      "title": "API process uptime",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_METRICS}"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "time() - max(process_start_time_seconds{job=\"prometheus.scrape.vodhunter_api\"})",
          "legendFormat": "",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No observations",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "description": "Current API process age. A restart resets process-local counters.",
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "id": 3
    },
    {
      "type": "stat",
      "title": "API resident memory",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_METRICS}"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(process_resident_memory_bytes{job=\"prometheus.scrape.vodhunter_api\"})",
          "legendFormat": "",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "noValue": "No observations",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "description": "API process RSS, not total VPS memory.",
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "id": 4
    },
    {
      "type": "timeseries",
      "title": "API CPU cores used",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_METRICS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "expr": "sum(rate(process_cpu_seconds_total{job=\"prometheus.scrape.vodhunter_api\"}[$__rate_interval]))",
          "legendFormat": "API",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No observations",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 12,
            "lineInterpolation": "linear",
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "description": "Process CPU seconds / wall seconds; 1 means one core.",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 5
    },
    {
      "type": "timeseries",
      "title": "API memory",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_METRICS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "targets": [
        {
          "expr": "sum(process_resident_memory_bytes{job=\"prometheus.scrape.vodhunter_api\"})",
          "legendFormat": "RSS",
          "refId": "A"
        },
        {
          "expr": "sum(process_virtual_memory_bytes{job=\"prometheus.scrape.vodhunter_api\"})",
          "legendFormat": "Virtual",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "noValue": "No observations",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 12,
            "lineInterpolation": "linear",
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 6
    },
    {
      "type": "timeseries",
      "title": "Log delivery by service",
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOGS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 13
      },
      "targets": [
        {
          "expr": "sum by (service_name) (count_over_time({service_name=~\"vodhunter-api|vodhunter-worker|vodhunter-retention\", environment=\"production\"}[$__interval]))",
          "refId": "A",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No observations",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 12,
            "lineInterpolation": "linear",
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "description": "Observed log volume. Quiet worker/retention periods do not prove a failed heartbeat.",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 7
    },
    {
      "type": "timeseries",
      "title": "Scrape duration",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_METRICS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 13
      },
      "targets": [
        {
          "expr": "max(scrape_duration_seconds{job=\"prometheus.scrape.vodhunter_api\"})",
          "legendFormat": "Scrape",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No observations",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 12,
            "lineInterpolation": "linear",
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 8
    },
    {
      "type": "table",
      "title": "Datasource inventory check",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_POSTGRES}"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 21
      },
      "targets": [
        {
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COUNT(*) AS reporting_streamers, SUM(searchable_vods) AS searchable_vods, SUM(stalled_vods) AS stalled_vods FROM grafana_streamer_summary",
          "refId": "A",
          "sql": {
            "columns": [],
            "groupBy": []
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "\u2014",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^(.*[ _]ID|search_id|Twitch VOD)$"
            },
            "properties": [
              {
                "id": "unit",
                "value": "none"
              }
            ]
          }
        ]
      },
      "description": "Querying the private reporting datasource confirms it is reachable.",
      "options": {
        "cellHeight": "sm",
        "showHeader": true
      },
      "id": 9
    },
    {
      "type": "timeseries",
      "title": "Exported metric samples",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_METRICS}"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 21
      },
      "targets": [
        {
          "expr": "max(scrape_samples_scraped{job=\"prometheus.scrape.vodhunter_api\"})",
          "legendFormat": "Samples",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No observations",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 12,
            "lineInterpolation": "linear",
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 10
    }
  ],
  "refresh": "1m",
  "schemaVersion": 39,
  "tags": [
    "vodhunter",
    "monitoring"
  ],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "title": "40 - Monitoring Health",
  "uid": "vodhunter-monitoring-health",
  "version": 1
}
