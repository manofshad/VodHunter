          "rawQuery": true,
          "rawSql": "SELECT profile_image_url AS \"Avatar\", streamer AS \"Streamer\", streamer_url AS \"Twitch\",\n                   total_vods AS \"VODs\", searchable_vods AS \"Complete\", active_vods AS \"Recent cursors\",\n                   stalled_vods AS \"Stale cursors\", reindex_requested_vods AS \"Reindex\",\n                   newest_vod_at AS \"Newest VOD\", last_ingest_update AS \"Last cursor update\"\n            FROM grafana_streamer_summary WHERE streamer IN (${streamer:sqlstring})\n            ORDER BY stalled_vods DESC, active_vods DESC, streamer",
