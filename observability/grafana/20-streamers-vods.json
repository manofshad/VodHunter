      "targets": [
        {
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT thumbnail_url AS \"Thumbnail\", streamer AS \"Streamer\", title AS \"Title\",\n                   vod_platform_id AS \"Twitch VOD\", vod_url AS \"VOD URL\", streamed_at AS \"Streamed at\",\n                   status AS \"Lifecycle\", operational_status AS \"Operational health\",\n                   ROUND(progress_percent::numeric, 1) AS \"Progress %\",\n                   last_ingested_seconds AS \"Ingested seconds\",\n                   last_seen_duration_seconds AS \"Observed seconds\",\n                   last_ingest_update AS \"Last progress\", cursor_age_seconds AS \"Cursor age seconds\"\n            FROM grafana_vod_inventory\n            WHERE ('${streamer}' = '.*' OR streamer = '${streamer}') AND status LIKE '${vod_status}'\n              AND (streamed_at IS NULL OR $__timeFilter(streamed_at))\n            ORDER BY streamed_at DESC NULLS LAST, video_id DESC LIMIT 500",
          "refId": "A",
          "sql": {
            "columns": [],
            "groupBy": []
