          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT profile_image_url AS \"Avatar\", streamer AS \"Streamer\", streamer_url AS \"Twitch\",\n                   total_vods AS \"VODs\", searchable_vods AS \"Complete\", active_vods AS \"Active\",\n                   stalled_vods AS \"Stalled\", reindex_requested_vods AS \"Reindex\",\n                   newest_vod_at AS \"Newest VOD\", last_ingest_update AS \"Last activity\"\n            FROM grafana_streamer_summary WHERE ('${streamer}' = '.*' OR streamer = '${streamer}')\n            ORDER BY stalled_vods DESC, active_vods DESC, streamer",
          "refId": "A",
