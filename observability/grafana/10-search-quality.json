          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(created_at, $__interval), outcome AS metric, COUNT(*)::double precision AS value FROM grafana_search_quality WHERE $__timeFilter(created_at) AND streamer IN (${streamer:sqlstring}) GROUP BY 1, outcome ORDER BY 1",
