        {
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT outcome AS \"Outcome\",\n                   COALESCE(error_code, result_reason, 'unspecified') AS \"Reason\",\n                   COUNT(*) AS \"Count\"\n            FROM grafana_search_quality\n            WHERE $__timeFilter(created_at) AND streamer IN (${streamer:sqlstring}) AND outcome <> 'match'\n            GROUP BY outcome, COALESCE(error_code, result_reason, 'unspecified')\n            ORDER BY \"Count\" DESC",
          "refId": "A",
          "sql": {
            "columns": [],
            "groupBy": []
