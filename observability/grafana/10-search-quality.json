          "rawSql": "SELECT feedback_updated_at AS \"Rating updated\", feedback_rating AS \"Rating\", search_id AS \"Search ID\", streamer AS \"Streamer\", tiktok_url AS \"Original clip URL\", matched_timestamp_seconds AS \"Matched timestamp seconds\", result_payload::text AS \"Result payload\", created_at, started_at, finished_at, job_status, job_stage, outcome, found_match, result_reason, score, error_code, error_message, source_app, route, input_type, download_source, download_host, input_duration_seconds, success, http_status, total_duration_ms, preprocess_duration_ms, embed_duration_ms, vector_query_duration_ms, alignment_duration_ms, model_startup_duration_ms, model_cold_start, fingerprint_preprocessing_duration_ms, fingerprint_inference_duration_ms, fingerprint_duration_ms, query_fingerprint_count, candidate_count, segment_count, model_version, preprocessing_version, streamed_from, streamed_to, matched_video_id, matched_video_title, matched_video_url, matched_video_streamed_at FROM grafana_search_feedback WHERE $__timeFilter(feedback_updated_at) AND streamer IN (${streamer:sqlstring}) ORDER BY feedback_updated_at DESC LIMIT 500",
