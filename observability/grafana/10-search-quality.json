      "targets": [
        {
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT streamer AS \"Streamer\", COUNT(*) AS \"Searches\",\n                   COUNT(*) FILTER (WHERE outcome = 'match') AS \"Matches\",\n                   ROUND(100.0 * COUNT(*) FILTER (WHERE outcome = 'match') / NULLIF(COUNT(*) FILTER (WHERE outcome IN ('match', 'no_match')), 0), 1) AS \"Match %\",\n                   ROUND(AVG(score) FILTER (WHERE outcome = 'match')::numeric, 3) AS \"Avg score\"\n            FROM grafana_search_quality WHERE $__timeFilter(created_at) AND streamer IN (${streamer:sqlstring})\n            GROUP BY streamer ORDER BY \"Searches\" DESC",
          "refId": "A",
          "sql": {
            "columns": [],
            "groupBy": []
          }
        }
      ],
      "title": "Quality by streamer",
      "type": "table"
