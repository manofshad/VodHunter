// Grafana Cloud pipeline for the first VodHunter observability slice.
// Credentials are injected by Compose/Coolify and are intentionally not
// committed to the repository.

prometheus.scrape "vodhunter_api" {
  targets = [{
    __address__ = "api:8000",
  }]
  metrics_path    = "/internal/metrics"
  scrape_interval = "15s"
  scrape_timeout  = "10s"
  forward_to      = [prometheus.remote_write.grafana_cloud.receiver]
}

prometheus.remote_write "grafana_cloud" {
  endpoint {
    url = sys.env("GRAFANA_CLOUD_PROMETHEUS_URL")

    basic_auth {
      username = sys.env("GRAFANA_CLOUD_PROMETHEUS_USER")
      password = sys.env("GRAFANA_CLOUD_API_TOKEN")
    }
  }
}

discovery.docker "vodhunter" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "vodhunter_api" {
  targets = discovery.docker.vodhunter.targets

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    regex         = "api"
    action        = "keep"
  }
}

loki.source.docker "vodhunter_api" {
  host    = "unix:///var/run/docker.sock"
  targets = discovery.relabel.vodhunter_api.output
  labels = {
    service_name = "vodhunter-api",
    environment  = sys.env("VODHUNTER_ENVIRONMENT"),
  }
  forward_to = [loki.process.vodhunter_api.receiver]
}

loki.process "vodhunter_api" {
  // The API emits JSON logs with a canonical lowercase level. Keep the regex
  // fallback during rolling deployments and for any legacy Uvicorn lines.
  stage.json {
    expressions = {
      level                    = "level",
      logger                   = "logger",
      event                    = "event",
      outcome                  = "outcome",
      search_id                = "search_id",
      streamer                 = "streamer",
      status                   = "status",
      total_duration_ms        = "total_duration_ms",
      result_link              = "result_link",
      result_timestamp_seconds = "result_timestamp_seconds",
      score                    = "score",
      error_code               = "error.code",
      client_address           = "client_address",
      http_method              = "http_method",
      url_path                 = "url_path",
      http_version             = "http_version",
      status_code              = "status_code",
    }
  }

  stage.regex {
    expression = "^(?P<legacy_level>TRACE|DEBUG|INFO|WARNING|ERROR|CRITICAL):"
  }

  stage.template {
    source   = "normalized_level"
    template = "{{ if .level }}{{ .level | ToLower }}{{ else if .legacy_level }}{{ .legacy_level | ToLower }}{{ end }}"
  }

  stage.labels {
    values = {
      level   = "normalized_level",
      event   = "",
      outcome = "",
    }
  }

  // IDs and URLs are intentionally structured metadata rather than Loki
  // stream labels: they are useful for lookup but have unbounded cardinality.
  stage.structured_metadata {
    values = {
      logger                   = "",
      search_id                = "",
      streamer                 = "",
      status                   = "",
      total_duration_ms        = "",
      result_link              = "",
      result_timestamp_seconds = "",
      score                    = "",
      error_code               = "",
      client_address           = "",
      http_method              = "",
      url_path                 = "",
      http_version             = "",
      status_code              = "",
    }
  }

  forward_to = [loki.write.grafana_cloud.receiver]
}

discovery.relabel "vodhunter_worker" {
  targets = discovery.docker.vodhunter.targets

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    regex         = "worker"
    action        = "keep"
  }
}

loki.source.docker "vodhunter_worker" {
  host    = "unix:///var/run/docker.sock"
  targets = discovery.relabel.vodhunter_worker.output
  labels = {
    service_name = "vodhunter-worker",
    environment  = sys.env("VODHUNTER_ENVIRONMENT"),
  }
  forward_to = [loki.process.vodhunter_worker.receiver]
}

loki.process "vodhunter_worker" {
  // Worker output is intentionally low-cardinality key/value text. Promote
  // only the bounded action and mode values; streamer/VOD identity remains
  // structured metadata and can be parsed for drill-down queries.
  stage.regex {
    expression = "^(?P<action>[a-z_]+)"
  }

  stage.regex {
    expression = "(?:^| )mode=(?P<mode>[^ ]+)"
  }

  stage.regex {
    expression = "(?:^| )event=(?P<worker_event>[^ ]+)"
  }

  stage.regex {
    expression = "(?:^| )streamer=(?P<streamer>[^ ]+)"
  }

  stage.regex {
    expression = "(?:^| )vod=(?P<vod_id>[^ ]+)"
  }

  stage.regex {
    expression = "(?:^| )progress=(?P<progress_percent>[0-9.]+)%"
  }

  stage.regex {
    expression = "(?:^| )backlog=(?P<backlog_size>[0-9]+)"
  }

  stage.labels {
    values = {
      action = "",
      mode   = "",
      event  = "worker_event",
    }
  }

  stage.structured_metadata {
    values = {
      streamer        = "",
      vod_id          = "",
      progress_percent = "",
      backlog_size    = "",
    }
  }

  forward_to = [loki.write.grafana_cloud.receiver]
}

discovery.relabel "vodhunter_retention" {
  targets = discovery.docker.vodhunter.targets

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    regex         = "vod-retention"
    action        = "keep"
  }
}

loki.source.docker "vodhunter_retention" {
  host    = "unix:///var/run/docker.sock"
  targets = discovery.relabel.vodhunter_retention.output
  labels = {
    service_name = "vodhunter-retention",
    environment  = sys.env("VODHUNTER_ENVIRONMENT"),
  }
  forward_to = [loki.process.vodhunter_retention.receiver]
}

loki.process "vodhunter_retention" {
  stage.regex {
    expression = "(?:^| )event=(?P<retention_event>[^ ]+)"
  }

  stage.regex {
    expression = "(?:^| )retention_days=(?P<retention_days>[0-9]+)"
  }

  stage.regex {
    expression = "(?:^| )deleted_count=(?P<deleted_count>[0-9]+)"
  }

  stage.labels {
    values = {
      event = "retention_event",
    }
  }

  stage.structured_metadata {
    values = {
      retention_days = "",
      deleted_count  = "",
    }
  }

  forward_to = [loki.write.grafana_cloud.receiver]
}

loki.write "grafana_cloud" {
  endpoint {
    url = sys.env("GRAFANA_CLOUD_LOKI_URL")

    basic_auth {
      username = sys.env("GRAFANA_CLOUD_LOKI_USER")
      password = sys.env("GRAFANA_CLOUD_API_TOKEN")
    }
  }
}
