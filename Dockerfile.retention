FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

RUN mkdir -p backend services runners

COPY backend/requirements-retention.txt ./backend/requirements-retention.txt
RUN pip install --no-cache-dir -r backend/requirements-retention.txt

COPY backend/config.py ./backend/config.py
COPY backend/db_url.py ./backend/db_url.py
COPY services/vod_retention.py ./services/vod_retention.py
COPY runners/run_vod_retention.py ./runners/run_vod_retention.py

CMD ["python", "-m", "runners.run_vod_retention"]
